pipeline {
    // add your slave label name
    agent { label 'raju'}
    
    stages {
        stage ('Checkout_SCM') {

            steps {
          	    
	     checkout scm
            }
        }

        stage ('Maven_Build') {

            steps {
               sh 'mvn clean package'
            }
        }
        
       stage('Deploy_Tomcat') {
           steps {
               sshagent(['tomcat_ssh']) {
                  sh './deploy.sh'
                       }
                    }
             }

        
    }
}
